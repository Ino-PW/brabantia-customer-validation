cade4dc0-5505-11f1-9a70-65d6167f6f21","referenceType":"parameter"},"code":"libname xl xlsx '/sasdata/groups/PWC_Intern_SSBI/data/regionale-statistieken/NUTS2021-NUTS2024.xlsx';\nlibname UK xlsx '/sasdata/groups/PWC_Intern_SSBI/data/regionale-statistieken/UK-NUTS.xlsx';\n\nlibname STAT '/sasdata/groups/PWC_Intern_SSBI/data/STAT';\n\noptions validvarname=v7;\ndata NUTS3_EU(drop=NUTS_level_3____italics__NUTS_20 _ Code_2021 Code_2024 NUTS_level_1____italics__NUTS_20 NUTS_level_2____italics__NUTS_20  change country_order Region_order__NUTS_2021_ Region_order__NUTS_2024_);\n    set xl.\"NUTS2021- NUTS2024\"n;\n    NUTS_code = Code_2021;\n    NUTS_Label = coalescec(NUTS_level_1____italics__NUTS_20,NUTS_level_2____italics__NUTS_20,NUTS_level_3____italics__NUTS_20);\n    if country_code in ('NL' 'DE' 'ES' 'FR' 'BE') then output;\nrun;\n\ndata NUTS3_UK(rename=(nuts_3_code = NUTS_Code NUTS_3_name=NUTS_label));\n    set UK.\"NUTS 3\"n;\n    country_code = 'UK';\n    NUTS_level = 3;\nrun;\n\ndata STAT.NUTS3_Names;\n    set NUTS3_EU NUTS3_UK;\nrun;\n\n\n    "}},"portMappings":[{"mappingType":"tableStructure","portName":"outTables","portIndex":0,"tableStructure":{"columnDefinitions":[]}}]},"cbf255d0-5505-11f1-9a70-65d6167f6f21":{"description":"","id":"cbf255d0-5505-11f1-9a70-65d6167f6f21","name":"002-Combineer-NUTS-ZipCodes.sas","nodeType":"step","note":null,"priority":1,"properties":{"UI_PROP_LOCATION":"204 27","UI_PROP_INPUT_PORT|inTables|0":"|Input table 1|Input tables","UI_PROP_OUTPUT_PORT|outTables|0":"|Output table 1|Output tables","UI_PROP_IS_INPUT_EXPANDED":"false","UI_PROP_IS_OUTPUT_EXPANDED":"false"},"version":1,"stepReference":{"type":"uri","path":"/dataFlows/steps/a7190700-f59c-4a94-afe2-214ce639fcde"},"arguments":{"codeOptions":{"variables":[{"name":"_input1","value":{"referenceType":"inputPort","portName":"inTables","portIndex":0}},{"name":"_output1","value":{"referenceType":"outputPort","portName":"outTables","portIndex":0,"arguments":{}}}],"contentType":"reference","inFile":{"parameterId":"cbf255d0-5505-11f1-9a70-65d6167f6f21","referenceType":"parameter"},"code":"proc import datafile='/sasdata/groups/PWC_Intern_SSBI/data/regionale-statistieken/pc2020_BE_NUTS-2021_v1.0.csv' dbms=csv out=BE_NUTS replace;\n    delimiter=';';\nrun;\nproc import datafile='/sasdata/groups/PWC_Intern_SSBI/data/regionale-statistieken/pc2020_DE_NUTS-2021_v4.0.csv' dbms=csv out=DE_NUTS replace;\n    delimiter=';';\nrun;\nproc import datafile='/sasdata/groups/PWC_Intern_SSBI/data/regionale-statistieken/pc2020_ES_NUTS-2021_v1.0.csv' dbms=csv out=ES_NUTS replace;\n    delimiter=';';\nrun;\nproc import datafile='/sasdata/groups/PWC_Intern_SSBI/data/regionale-statistieken/pc2020_FR_NUTS-2021_v2.0.csv' dbms=csv out=FR_NUTS replace;\n    delimiter=';';\nrun;\nproc import datafile='/sasdata/groups/PWC_Intern_SSBI/data/regionale-statistieken/pc2020_NL_NUTS-2021_v2.0.csv' dbms=csv out=NL_NUTS replace;\n    delimiter=';';\nrun;\nproc import datafile='/sasdata/groups/PWC_Intern_SSBI/data/regionale-statistieken/pc2020_UK_NUTS-2021_v.3.0.csv' dbms=csv out=UK_NUTS replace;\n    delimiter=';';\nrun;\n\ndata work.NUTS_COMBINED;\n    length code $12;\n    set FR_NUTS UK_NUTS NL_NUTS ES_NUTS DE_NUTS BE_NUTS;\nrun;\n\nlibname STAT '/sasdata/groups/PWC_Intern_SSBI/data/STAT';\n\nproc sort data= NUTS_COMBINED;\n    by NUTS3;\nrun;\n\nproc sort data = STAT.nuts3_names(rename=(NUTS_Code = NUTS3)) out=NUTS3_names;\n    by NUTS3;\nrun;\n\ndata STAT.NUTS_ZIP_NAME;\n    merge  NUTS_COMBINED NUTS3_names;\n    by NUTS3;\n    code = compress(code,' ');\n    if code ne '' then output;\nrun;\n"}},"portMappings":[{"mappingType":"tableStructure","portName":"outTables","portIndex":0,"tableStructure":{"columnDefinitions":[]}}]},"cd378000-5505-11f1-9a70-65d6167f6f21":{"description":"","id":"cd378000-5505-11f1-9a70-65d6167f6f21","name":"003-Toevoegen-EU-Inkomen.sas","nodeType":"step","note":null,"priority":2,"properties":{"UI_PROP_LOCATION":"355 27","UI_PROP_INPUT_PORT|inTables|0":"|Input table 1|Input tables","UI_PROP_OUTPUT_PORT|outTables|0":"|Output table 1|Output tables","UI_PROP_IS_INPUT_EXPANDED":"false","UI_PROP_IS_OUTPUT_EXPANDED":"false"},"version":1,"stepReference":{"type":"uri","path":"/dataFlows/steps/a7190700-f59c-4a94-afe2-214ce639fcde"},"arguments":{"codeOptions":{"variables":[{"name":"_input1","value":{"referenceType":"inputPort","portName":"inTables","portIndex":0}},{"name":"_output1","value":{"referenceType":"outputPort","portName":"outTables","portIndex":0,"arguments":{}}}],"contentType":"reference","inFile":{"parameterId":"cd378000-5505-11f1-9a70-65d6167f6f21","referenceType":"parameter"},"code":"libname EU xlsx '/sasdata/groups/PWC_Intern_SSBI/data/regionale-statistieken/EU_PPS_2023.xlsx';\nlibname STAT '/sasdata/groups/PWC_Intern_SSBI/data/STAT';\n\noptions validvarname=v7;\ndata STAT.EU_PPS(rename=(GEO__Codes_=Nuts3 GEO__Labels_=GEO_Labels PPS=Koopkracht));\n    set EU.\"Sheet 1\"n;\nrun;\n\nproc sort data=STAT.EU_PPS;\n    by nuts3;\nrun;\n\ndata STAT.NUTS_ZIP_NAME(drop= nuts_level GEO_Labels);\n    merge STAT.NUTS_ZIP_NAME STAT.EU_PPS;\n    by nuts3;\n    if code ne '' then output;\nrun;"}},"portMappings":[{"mappingType":"tableStructure","portName":"outTables","portIndex":0,"tableStructure":{"columnDefinitions":[]}}]},"ce6885f0-5505-11f1-9a70-65d6167f6f21":{"description":"","id":"ce6885f0-5505-11f1-9a70-65d6167f6f21","name":"004-Toevoegen-UK-Inkomen.sas","nodeType":"step","note":null,"priority":3,"properties":{"UI_PROP_LOCATION":"506 27","UI_PROP_INPUT_PORT|inTables|0":"|Input table 1|Input tables","UI_PROP_OUTPUT_PORT|outTables|0":"|Output table 1|Output tables","UI_PROP_IS_INPUT_EXPANDED":"false","UI_PROP_IS_OUTPUT_EXPANDED":"false"},"version":1,"stepReference":{"type":"uri","path":"/dataFlows/steps/a7190700-f59c-4a94-afe2-214ce639fcde"},"arguments":{"codeOptions":{"variables":[{"name":"_input1","value":{"referenceType":"inputPort","portName":"inTables","portIndex":0}},{"name":"_output1","value":{"referenceType":"outputPort","portName":"outTables","portIndex":0,"arguments":{}}}],"contentType":"reference","inFile":{"parameterId":"ce6885f0-5505-11f1-9a70-65d6167f6f21","referenceType":"parameter"},"code":"libname UK xlsx '/sasdata/groups/PWC_Intern_SSBI/data/regionale-statistieken/UK_inkomen_2023.xlsx';\nlibname STAT '/sasdata/groups/PWC_Intern_SSBI/data/STAT';\n\noptions validvarname=v7;\ndata STAT.UK_Inkomen(rename=( Region_name=NUTS_Label) drop =ITL _2023);\n    set UK.\"GDHI-Head\"n;\n    where ITL = 'ITL3';\n    \n    Inkomen = input(_2023,10.);\n\n    if ITL_code = 'TLN06' then nuts3 = 'UKN06';\n    else if ITL_code = 'TLN07' then nuts3 = 'UKN07';\n    else if ITL_code = 'TLN08' then nuts3 = 'UKN08';\n    else if ITL_code = 'TLN09' then nuts3 = 'UKN09';\n    else if ITL_code = 'TLN0A' then nuts3 = 'UKN10';\n    else if ITL_code = 'TLN0B' then nuts3 = 'UKN11';\n    else if ITL_code = 'TLN0C' then nuts3 = 'UKN12';\n    else if ITL_code = 'TLN0D' then nuts3 = 'UKN13';\n    else if ITL_code = 'TLN0E' then nuts3 = 'UKN14';\n    else if ITL_code = 'TLN0F' then nuts3 = 'UKN15';\n    else if ITL_code = 'TLN0G' then nuts3 = 'UKN16';\n    \n    else if ITL_code = 'TLK51' then nuts3 = 'UKK11';\n    else if ITL_code = 'TLK52' then nuts3 = 'UKK12';\n    else if ITL_code = 'TLK73' then nuts3 = 'UKK13';\n    else if ITL_code = 'TLK71' then nuts3 = 'UKK14';\n    else if ITL_code = 'TLK72' then nuts3 = 'UKK15';\n    else if ITL_code = 'TLK24' then nuts3 = 'UKK21';\n    else if ITL_code = 'TLK25' then nuts3 = 'UKK22';\n    else if ITL_code = 'TLK23' then nuts3 = 'UKK23';\n\n    else if ITL_code = 'TLC31' then nuts3 = 'UKC11';\n    else if ITL_code = 'TLC32' then nuts3 = 'UKC12';\n    else if ITL_code = 'TLC33' then nuts3 = 'UKC13';\n    else if ITL_code = 'TLC41' then nuts3 = 'UKC14';\n    else if ITL_code = 'TLC42' then nuts3 = 'UKC21';\n    else if ITL_code = 'TLC43' then nuts3 = 'UKC22';\n    else if ITL_code = 'TLC44' then nuts3 = 'UKC23';\n\n    else if ITL_code = 'TLD13' then nuts3 = 'UKD11';\n    else if ITL_code = 'TLD14' then nuts3 = 'UKD12';\n\n    else if ITL_code = 'TLE33' then nuts3 = 'UKE31';\n    else if ITL_code = 'TLE34' then nuts3 = 'UKE31';\n    else if ITL_code = 'TLE35' then nuts3 = 'UKE31';\n    else if ITL_code = 'TLE32' then nuts3 = 'UKE32';\n\n    else if ITL_code = 'TLH41' then nuts3 = 'UKH11';\n    else if ITL_code = 'TLH42' then nuts3 = 'UKH12';\n\n    else if ITL_code = 'TLH51' then ITL_code = 'TLH15';\n    else if ITL_code = 'TLH52' then ITL_code = 'TLH16';\n    else if ITL_code = 'TLH53' then ITL_code = 'TLH17';\n\n    else if ITL_code = 'TLH61' then ITL_code = 'TLH14';\n    else if ITL_code = 'TLH62' then ITL_code = 'TLH14';\n    else if ITL_code = 'TLH63' then ITL_code = 'TLH14';\n    else if ITL_code = 'TLH64' then ITL_code = 'TLH14';\n    else if ITL_code = 'TLH14' then nuts3 = 'UKH14';\n\n    else if ITL_code = 'TLI36' then nuts3 = 'UKI31';\n    else if ITL_code = 'TLI35' then nuts3 = 'UKI32';\n\n    else if ITL_code = 'TLJ15' then nuts3 = 'UKJ11';\n    else if ITL_code = 'TLJ16' then nuts3 = 'UKJ11';\n\n    else if ITL_code = 'TLL31' then nuts3 = 'UKL11';\n    else if ITL_code = 'TLL32' then nuts3 = 'UKL12';\n    else if ITL_code = 'TLL33' then nuts3 = 'UKL13';\n    else if ITL_code = 'TLL42' then nuts3 = 'UKL14';\n    else if ITL_code = 'TLL51' then nuts3 = 'UKL15';\n    else if ITL_code = 'TLL53' then nuts3 = 'UKL16';\n    else if ITL_code = 'TLL44' then nuts3 = 'UKL17';\n    else if ITL_code = 'TLL43' then nuts3 = 'UKL18';\n    else if ITL_code = 'TLL54' then nuts3 = 'UKL21';\n    else if ITL_code = 'TLL52' then nuts3 = 'UKL22';\n    else if ITL_code = 'TLL34' then nuts3 = 'UKL23';\n    else if ITL_code = 'TLL41' then nuts3 = 'UKL24';\n\n    else if ITL_code = 'TLM50' then nuts3 = 'UKL11';\n    else if ITL_code = 'TLM03' then nuts3 = 'UKM71';\n    else if ITL_code = 'TLM01' then nuts3 = 'UKM72';\n    else if ITL_code = 'TLM11' then nuts3 = 'UKM73';\n    else if ITL_code = 'TLM13' then nuts3 = 'UKM75';\n    else if ITL_code = 'TLM12' then nuts3 = 'UKM76';\n    else if ITL_code = 'TLM02' then nuts3 = 'UKM77';\n    else if ITL_code = 'TLM14' then nuts3 = 'UKM78';\n    else if ITL_code = 'TLM31' then nuts3 = 'UKM81';\n    else if ITL_code = 'TLM32' then nuts3 = 'UKM82';\n    else if ITL_code = 'TLM33' then nuts3 = 'UKM83';\n    else if ITL_code = 'TLM34' then nuts3 = 'UKM84';\n    else nuts3 = cat('UK', substr(ITL_code,3));\n\n    if ITL_code = 'TLH14' then nuts3 = 'UKH14';\n    if ITL_code = 'TLH15' then nuts3 = 'UKH15';\n    if ITL_code = 'TLH16' then nuts3 = 'UKH16';\n    if ITL_code = 'TLH17' then nuts3 = 'UKH17';\nrun;\n\nproc sort data=STAT.uk_inkomen;\n    by nuts3;\nrun;\n\nproc sort data=STAT.NUTS_ZIP_NAME;\n    by nuts3;\nrun;\n\ndata STAT.NUTS_ZIP_NAME(drop= ITL_code Inkomen);\n    merge STAT.NUTS_ZIP_NAME STAT.UK_Inkomen;\n    by nuts3;\n    if inkomen ne . then Koopkracht = Inkomen;\nrun;\n"}},"portMappings":[{"mappingType":"tableStructure","portName":"outTables","portIndex":0,"tableStructure":{"columnDefinitions":[]}}]},"b8f6d920-55db-11f1-a907-7b6835d56d6a":{"description":"","id":"b8f6d920-55db-11f1-a907-7b6835d56d6a","name":"005-Toevoegen-Labels.sas","nodeType":"step","note":null,"priority":4,"properties":{"UI_PROP_LOCATION":"657 27","UI_PROP_INPUT_PORT|inTables|0":"|Input table 1|Input tables","UI_PROP_OUTPUT_PORT|outTables|0":"|Output table 1|Output tables","UI_PROP_IS_INPUT_EXPANDED":"false","UI_PROP_IS_OUTPUT_EXPANDED":"false"},"version":1,"stepReference":{"type":"uri","path":"/dataFlows/steps/a7190700-f59c-4a94-afe2-214ce639fcde"},"arguments":{"codeOptions":{"variables":[{"name":"_input1","value":{"referenceType":"inputPort","portName":"inTables","portIndex":0}},{"name":"_output1","value":{"referenceType":"outputPort","portName":"outTables","portIndex":0,"arguments":{}}}],"contentType":"reference","inFile":{"parameterId":"b8f6d920-55db-11f1-a907-7b6835d56d6a","referenceType":"parameter"},"code":"libname STAT '/sasdata/groups/PWC_Intern_SSBI/data/STAT';\nlibname pwcfmt '/sasdata/groups/PWC_Intern_SSBI/data/format_library';\n\nDATA fmt_input;\n    SET stat.NUTS_ZIP_NAME;\n    FMTNAME = 'nuts3_fmt';\n    START   = nuts3;\n    END     = nuts3;\n    LABEL   = NUTS_label;\n    TYPE    = 'C';\n    drop nuts3 code country_code nuts_label koopkracht;\nRUN;\n\nproc sort data= fmt_input nodupkey;\n    by start;\nrun;\n\nproc format casfmtlib='pwcfmt' library=pwcfmt cntlin=fmt_input;\nrun;\n\nproc format library=pwcfmt casfmtlib='pwcfmt';\n    value $ country_fmt 'NL' = 'Nederland'\n                        'DE' = 'Duitsland'\n                        'ES' = 'Spanje'\n                        'FR' = 'Frankrijk'\n                        'GB' = 'Verenigd Koninkrijk'\n                        'BE' = 'België';\nrun;\n\ndata stat.NUTS_ZIP_NAME;\n    set stat.NUTS_ZIP_NAME;\n    format  nuts3 $nuts3_fmt.\n            country_code $country_fmt.;\nrun;\n\nproc cas;\n    sessionprop.promotefmtlib /\n        fmtlibname=\"pwcfmt\",\n        replace=true;\nrun;\n   sessionProp.listFmtLibs /              \n      fmtLibName=\"pwcfmt\",\n      scope=\"global\",\n      showMemNames=true;\nrun;\nquit;"}},"portMappings":[{"mappingType":"tableStructure","portName":"outTables","portIndex":0,"tableStructure":{"columnDefinitions":[]}}]},"e0f3b930-c731-11f1-945b-8d25c0d69d3d":{"description":"","id":"e0f3b930-c731-11f1-945b-8d25c0d69d3d","name":"008-inwoners-aantallen.sas","nodeType":"step","note":null,"priority":5,"properties":{"UI_PROP_LOCATION":"803 32.83332824707031","UI_PROP_INPUT_PORT|inTables|0":"|Input table 1|Input tables","UI_PROP_OUTPUT_PORT|outTables|0":"|Output table 1|Output tables","UI_PROP_IS_INPUT_EXPANDED":"false","UI_PROP_IS_OUTPUT_EXPANDED":"false"},"version":1,"stepReference":{"type":"uri","path":"/dataFlows/steps/a7190700-f59c-4a94-afe2-214ce639fcde"},"arguments":{"codeOptions":{"variables":[{"name":"_input1","value":{"referenceType":"inputPort","portName":"inTables","portIndex":0}},{"name":"_output1","value":{"referenceType":"outputPort","port