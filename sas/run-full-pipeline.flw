{"id":"\"ko3utot292\"","connections":[],"creationTimeStamp":"2026-07-09T09:46:51.443Z","description":"","eTag":"\"ko3vkyr3c4\"","extendedProperties":{},"modifiedTimeStamp":"2026-07-09T09:19:22.295Z","name":"run-full-pipeline.flw","nodes":{"e6fd1860-5505-11f1-9a70-65d6167f6f21":{"description":"","id":"e6fd1860-5505-11f1-9a70-65d6167f6f21","name":"Swimlane 2","nodeType":"dataFlow","note":null,"priority":0,"properties":{"UI_PROP_IS_EXPANDED":"true","UI_PROP_LOCATION":"0 36.33333292007447"},"version":1,"dataFlowAndBindings":{"dataFlow":{"id":null,"connections":[{"sourcePort":{"node":"e9723710-5505-11f1-9a70-65d6167f6f21","portName":"outTables","index":0},"targetPort":{"node":"eabb7ff0-5505-11f1-9a70-65d6167f6f21","portName":"inTables","index":0}}],"createdBy":null,"creationTimeStamp":"2026-08-18T08:49:38.867Z","description":"","eTag":null,"extendedProperties":{},"modifiedBy":null,"modifiedTimeStamp":"2026-08-18T08:49:38.867Z","name":"","nodes":{"e9723710-5505-11f1-9a70-65d6167f6f21":{"description":"","id":"e9723710-5505-11f1-9a70-65d6167f6f21","name":"010-import_naar_cas.sas","nodeType":"step","note":null,"priority":0,"properties":{"UI_PROP_LOCATION":"65 63.33333292007447","UI_PROP_INPUT_PORT|inTables|0":"|Input table 1|Input tables","UI_PROP_OUTPUT_PORT|outTables|0":"|Output table 1|Output tables","UI_PROP_IS_INPUT_EXPANDED":"false","UI_PROP_IS_OUTPUT_EXPANDED":"false"},"version":1,"stepReference":{"type":"uri","path":"/dataFlows/steps/a7190700-f59c-4a94-afe2-214ce639fcde"},"arguments":{"codeOptions":{"variables":[{"name":"_input1","value":{"referenceType":"inputPort","portName":"inTables","portIndex":0}},{"name":"_output1","value":{"referenceType":"outputPort","portName":"outTables","portIndex":0,"arguments":{}}}],"contentType":"reference","inFile":{"parameterId":"e9723710-5505-11f1-9a70-65d6167f6f21","referenceType":"parameter"},"code":"/* Activeer alle beschikbare caslibs (o.a. voor autoload.dim_date) */\ncaslib _all_ assign;\n\n/* ============================================================\n   SCRIPT  : 010-import_naar_cas.sas\n   DOEL    : Verwerking en verrijking van PWC consumentenorder-\n             en adresdata. Koppeling met NUTS-koopkrachtdata en\n             fiscale datumtabel. Segmentatie op productcategorie.\n   OUTPUT  : public.pwc_consument_data\n             public.pwc_lekue_consumenten\n   ============================================================ */\n\n\n\n/* Permanente library voor NUTS/koopkrachtdata */\nlibname STAT '/sasdata/groups/PWC_Intern_SSBI/data/STAT';\n\n/* Bronbestanden: consumentenorders en adressenexport */\nfilename data  '/sasdata/groups/PWC_Intern_SSBI/data/20260513_consumer_export.csv';\nfilename adres '/sasdata/groups/PWC_Intern_SSBI/data/20260520_adresses_export.csv';\nfilename pkor '/sasdata/groups/PWC_Intern_SSBI/data/20260529_personeels_korting.csv';\n\n\n/* Library voor formats */\nlibname library '/sasdata/groups/PWC_Intern_SSBI/data/format_library';\n\n/* Sta underscores toe in variabelenamen (SAS v7-conventie) */\noptions validvarname = v7;\n\n/* ------------------------------------------------------------\n   STAP 1: Inlezen adresdata\n   Gebruik guessingrows=20000 voor betrouwbare type-detectie\n   bij grote of gevarieerde bestanden.\n   ------------------------------------------------------------ */\nproc import datafile=adres out=work.adresses_data dbms='csv' replace;\n    guessingrows=MAX;\n    delimiter=';';\nrun;\n\n/* ------------------------------------------------------------\n   STAP 2: Opschonen adresdata\n   - Verwijder interne bronsysteemkolom (meta_src_code___)\n   - Hernoem persoonssleutel naar uniforme naam\n   - Converteer order_number_functional van numeriek naar\n     karakter zodat de merge met consumentendata correct werkt\n   ------------------------------------------------------------ */\ndata work.adresses_data(drop=meta_src_code evt_qty_returned rename=(prd_person_key_md5=master_person_key_md5));\n    set work.adresses_data;\n    /* Numeriek naar karakter om merge-conflicten te voorkomen */\n    order_number_functional_c = strip(put(order_number_functional, best32.));\n    drop order_number_functional;\n    rename order_number_functional_c = order_number_functional;\nrun;\n\n/* ------------------------------------------------------------\n   STAP 3: CAS-tabellen opschonen\n   Verwijder eventueel bestaande versies van de outputtabellen\n   zodat aanmaak later in het script niet faalt.\n   'quiet' onderdrukt een waarschuwing als de tabel niet bestaat.\n   ------------------------------------------------------------ */\nproc casutil;\n    droptable casdata=\"pwc_consument_data\"    incaslib=\"public\" quiet;\n    droptable casdata=\"pwc_lekue_consumenten\" incaslib=\"public\" quiet;\nquit;\n\n/* ------------------------------------------------------------\n   STAP 4: Inlezen consumentendata\n   ------------------------------------------------------------ */\nproc import datafile=data out=work.consument_data dbms='csv' replace;\n    guessingrows=MAX;\n    delimiter=';';\nrun;\n\nproc import datafile=pkor out=work.personeel_korting dbms='csv' replace;\n    guessingrows=max;\n    delimiter=';';\nrun;\n\ndata work.personeel_korting;\n    set work.personeel_korting (rename=(order_number_functional=_order_num));\n    order_number_functional = strip(put(_order_num, best32.));\n    drop _order_num;\nrun;\n\n/* Bestellingen met personeels korting moeten worden weggenomen */\nproc sort data=work.consument_data;    by order_number_functional; run;\nproc sort data=work.personeel_korting; by order_number_functional; run;\n\ndata work.consument_data;\n    merge   consument_data      (in=a)\n            personeel_korting   (in=b);\n    by order_number_functional;\n    if a and not b then output work.consument_data;\nrun;\n\n\n\n\n/* Sorteren op samengestelde sleutel voor de merge in stap 5 */\nproc sort data=work.adresses_data;      by master_person_key_md5 order_number_functional;        run;\nproc sort data=work.consument_data;     by master_person_key_md5 order_number_functional;       run;\n\ndata work.consument_data;\n    set work.consument_data;\n    by master_person_key_md5 order_number_functional;\n    if first.order_number_functional;\nrun;\n\n/* ------------------------------------------------------------\n   STAP 5: Samenvoegen consumentendata met adresdata\n   Expliciete lengtes voorkomen truncatie bij langere waarden.\n   'if b' = alleen records met een bekend adres worden bewaard;\n   orders zonder adresrecord vallen weg.\n   ------------------------------------------------------------ */\ndata work.consument_data_new;\n    length prd_city     $ 28\n           prd_zipcode  $ 14;\n    merge work.consument_data  (in=a rename=(\n              total_products_in_order        = _total_products_in_order\n              orderline_sales                = _orderline_sales\n              total_orders                   = _total_orders\n              orderline_sales_after_discount = _orderline_sales_after_discount\n              orderline_discount             = _orderline_discount\n          ))\n          work.adresses_data   (in=b);\n    by master_person_key_md5 order_number_functional order_date;\n    if a;\n\n    net_sales                      = input(compress(net_sales_________, \"'\"\"`,\"), NLMNLEUR8.2);\n    total_products_in_order        = input(strip(_total_products_in_order), 8.);\n    orderline_sales                = input(strip(_orderline_sales), NLMNLEUR8.2);\n    total_orders                   = input(strip(_total_orders), 8.);\n    orderline_sales_after_discount = input(strip(_orderline_sales_after_discount), NLMNLEUR8.2);\n    orderline_discount             = input(strip(_orderline_discount), NLMNLEUR8.2);\n\n    drop _total_products_in_order _orderline_sales\n         _total_orders _orderline_sales_after_discount _orderline_discount\n         net_sales_________ var21 var9;\nrun;\n\n/* ------------------------------------------------------------\n   STAP 6: Standaardisatie van land, postcode en gender\n   - prd_zipcode  : witruimte verwijderen\n   - prd_country  : naar hoofdletters; 'GB' -> 'UK' voor\n                    aansluiting op de NUTS-koppeltabel\n   - prd_gender   : naar hoofdletters en getrimd;\n                    'F' -> 'V' (Nederlandstalige codering)\n   ------------------------------------------------------------ */\ndata work.consument_data_new;\n    set work.consument_data_new;\n    prd_zipcode =trim(prd_zipcode);\n    prd_city =trim(prd_city);\n    prd_country = UPCASE(prd_country);\n    if prd_country = 'GB' then prd_country = 'UK';\n    prd_gender = UPCASE(trim(prd_gender));\n    if prd_gender = 'F' then prd_gender = 'V';\nrun;\n\n\n/* ------------------------------------------------------------\n   STAP 7: Koppeling met NUTS-koopkrachtdata\n   Match op postcode en land (beide moeten overeenkomen).\n   Als het land niet overeenkomt krijgt NUTS3 de waarde 'N/A'.\n   Voegt toe: NUTS3, koopkracht, NUTS_Label\n   ------------------------------------------------------------ */\nproc sql;\n    create table work.consument_sorted_data_w_nuts as\n    select\n        cd.*,\n        case\n            when eun.country_code ne cd.prd_country then 'N/A'\n            else eun.NUTS3\n        end as NUTS3,\n        eun.koopkracht,\n        eun.NUTS_Label\n    from work.consument_data_new as cd\n    left join STAT.NUTS_ZIP_NAME as eun\n        on cd.prd_zipcode = trim(eun.code) and cd.prd_country = eun.country_code\n    order by cd.master_person_key_md5, order_number_functional;\nquit;\n\n\n\n\n/* ------------------------------------------------------------\n   STAP 8: Verwijder originele week- en jaarkolommen\n   Deze worden in stap 10 vervangen door de fiscale definities\n   conform de Brabantia-weeknummering (via dim_date).\n   ------------------------------------------------------------ */\nproc sql;\n    alter table work.consument_sorted_data_w_nuts\n    drop column week, year;\nquit;\n\n\n\n/* ------------------------------------------------------------\n   STAP 9: Koppeling met fiscale datumtabel\n   Vervangt de verwijderde week/jaar door fiscale equivalenten:\n   - week_fisc -> week\n   - year_fisc -> year\n   Bron: autoload.dim_date, gekoppeld op order_date = date.\n   ------------------------------------------------------------ */\nproc sql;\n    create table work.cons_data_w_date as\n    select\n        cd.*,\n        d.week_fisc as week,\n        d.year_fisc as year\n    from work.consument_sorted_data_w_nuts as cd\n    left join autoload.dim_date as d on cd.order_date = d.date;\nquit;\n\n\n/* ------------------------------------------------------------\n   STAP 10: Eindtransformaties en wegschrijven\n   Berekeningen:\n   - Categoriecounts uit all_categories (waste_management t/m other)\n   - Landcodering terugzetten: 'UK' -> 'GB' (ISO-standaard output)\n   - Lege gender -> 'O' (Overig/Onbekend)\n   - gender_encoded: M=1, V=2, O=3\n   - age: leeftijd op moment van aankoop (0 als onbekend)\n   - Fallback voor ontbrekende total_orders en net_sales\n\n   Outputsplitsing:\n   - lekue > 0  -> work.lekue_consument_data (Lekue-segment)\n   - overig     -> public.pwc_consument_data (hoofdtabel, CAS)\n   ------------------------------------------------------------ */\ndata public.pwc_consument_data(promote=yes) work.lekue_consument_data work.total_orders_too_high;\n    set work.cons_data_w_date;\n\n    /* Categoriecounts: tel hoe vaak elke categorie voorkomt in all_categories */\n    length waste_management bathroom_toilet food_enjoyment laundry_caring service lekue other 8;\n    waste_management = 0; bathroom_toilet = 0; food_enjoyment = 0;\n    laundry_caring   = 0; service         = 0; lekue          = 0; other = 0;\n\n    waste_management = count(all_categories, 'Waste Management');\n    bathroom_toilet  = count(all_categories, 'Bathroom and Toilet');\n    food_enjoyment   = count(all_categories, 'Food Enjoyment');\n    laundry_caring   = count(all_categories, 'Laundry Caring');\n    service          = count(all_categories, 'Service');\n    lekue            = count(all_categories, 'Lékué');  /* Let op: exacte spelling vereist */\n    other            = count(all_categories, 'other');\n    _2024            = count(year, '2024');\n    _2025            = count(year, '2025');\n\n\n    /* Landcodering terug naar ISO-standaard voor extern gebruik */\n    if prd_country = 'UK' then prd_country = 'GB';\n\n    /* Onbekend gender expliciete waarde geven */\n    if prd_gender = ' ' then prd_gender = 'O';\n\n    /* Numerieke codering van gender voor modellen en analyses */\n    gender_encoded = 0;\n    if UPCASE(prd_gender) = 'M' then gender_encoded = 1;\n    if UPCASE(prd_gender) = 'V' then gender_encoded = 2;\n    if UPCASE(prd_gender) = 'O' then gender_encoded = 3;\n\n    /* Leeftijd op aankoopdatum; 0 als geboortedatum ontbreekt */\n    age = 0;\n    if prd_birth_date ne '' or . then age = intck('year', prd_birth_date, order_date);\n\n    /* Fallback voor ontbrekende ordertellingen en omzetwaarden */\n    if total_orders = . then total_orders = 1;\n    if missing(net_sales) or net_sales = 0  then net_sales    = orderline_sales_after_discount;\n\n\n    /* format nuts3 $nuts3_fmt.;\n    format prd_country $country_fmt.; */\n\n    /* Splitsen: Lekue-orders apart, rest naar hoofdtabel */\n    if lekue > 0 then output work.lekue_consument_data;\n    else if total_orders>50 then output work.total_orders_too_high;\n\n    else output public.pwc_consument_data;\nrun;\n\ndata public.pwc_consument_data;\n    set public.pwc_consument_data;\n    by master_person_key_md5;\n\n /* Initialiseer alle campagne-variabelen */\n    retain outlet_jan_2024 droog_molen_actie refresh_steam_win design_your_bin\n           droog_molen_promo_w26_2024 outlet_jul_2024 back_to_school\n           bin_liner_promo outlet_jan_2025 droog_molen_promo_w10_2025\n           droog_molen_promo_w20_2025 droog_molen_promo_w28_2025\n           outlet_jul_2025 make_and_take newicon_win pink_lilac_strijkplank\n           /* Seizoenen */\n           post_holiday spring_sales back_to_school_season pre_holiday off_peak 0;\n\n    /* Reset bij nieuwe klant */\n    if first.master_person_key_md5 then do;\n        outlet_jan_2024            = 0;\n        droog_molen_actie          = 0;\n        refresh_steam_win          = 0;\n        design_your_bin            = 0;\n        droog_molen_promo_w26_2024 = 0;\n        outlet_jul_2024            = 0;\n        back_to_school             = 0;\n        bin_liner_promo            = 0;\n        outlet_jan_2025            = 0;\n        droog_molen_promo_2025     = 0;\n        make_and_take              = 0;\n        newicon_win                = 0;\n        pink_lilac_strijkplank     = 0;\n        outlet_jul_2025            = 0;\n        /* Seizoenen */\n        post_holiday               = 0;\n        spring_sales               = 0;\n        back_to_school_season      = 0;\n        pre_holiday                = 0;\n        off_peak                   = 0;\n    end;\n\n    /* 2024 campagnes */\n    if year = 2024 and (week >= 1  and week <= 4)         then outlet_jan_2024            + 1;\n    if year = 2024 and (week >= 15 and week <= 35)        then droog_molen_actie          + 1;\n    if year = 2024 and (week >= 20 and week <= 21)        then refresh_steam_win          + 1;\n    if year = 2024 and week = 23                          then design_your_bin            + 1;\n    if year = 2024 and week = 26                          then droog_molen_promo_w26_2024 + 1;\n    if year = 2024 and (week >= 27 and week <= 30)        then outlet_jul_2024            + 1;\n    if year = 2024 and (week >= 33 and week <= 36)        then back_to_school             + 1;\n    if year = 2024 and (week >= 40 and week <= 44)        then bin_liner_promo            + 1;\n\n    /* 2025 campagnes */\n    if year = 2025 and (week >= 1  and week <= 4)         then outlet_jan_2025            + 1;\n    if year = 2025 and (week >= 10 and week <= 28)        then droog_molen_promo_2025     + 1;\n    if year = 2025 and (week >= 27 and week <= 30)        then outlet_jul_2025            + 1;\n    if year = 2025 and (week >= 33 and week <= 35)        then make_and_take              + 1;\n    if year = 2025 and (week >= 37 and week <= 38)        then newicon_win                + 1;\n    if year = 2025 and week = 50                          then pink_lilac_strijkplank     + 1;\n\n    /* Seizoenen */\n    if week >= 1  and week <= 4  then post_holiday           + 1;\n    if week >= 10 and week <= 17 then spring_sales           + 1;\n    if week >= 31 and week <= 39 then back_to_school_season  + 1;\n    if week >= 44 and week <= 52 then pre_holiday            + 1;\n    if week >= 5  and week <= 9  then off_peak               + 1;\n    if week >= 18 and week <= 30 then off_peak               + 1;\n    if week >= 40 and week <= 43 then off_peak               + 1;\nrun;\n\n\n/* ------------------------------------------------------------\n   STAP 11: Wegschrijven Lekue-consumenten naar CAS\n   Gepromoveerde tabel beschikbaar voor alle CAS-sessies.\n   ------------------------------------------------------------ */\ndata public.pwc_lekue_consumenten(promote=yes);\n    set work.lekue_consument_data;\nrun;"}},"portMappings":[{"mappingType":"tableStructure","portName":"outTables","portIndex":0,"tableStructure":{"columnDefinitions":[]}}]},"eabb7ff0-5505-11f1-9a70-65d6167f6f21":{"description":"","id":"eabb7ff0-5505-11f1-9a70-65d6167f6f21","name":"020-order-naar-consument-aggregatie.sas","nodeType":"step","note":null,"priority":1,"properties":{"UI_PROP_LOCATION":"216 63.33333292007447","UI_PROP_INPUT_PORT|inTables|0":"|Input table 1|Input tables","UI_PROP_OUTPUT_PORT|outTables|0":"|Output table 1|Output tables","UI_PROP_IS_INPUT_EXPANDED":"false","UI_PROP_IS_OUTPUT_EXPANDED":"false"},"version":1,"stepReference":{"type":"uri","path":"/dataFlows/steps/a7190700-f59c-4a94-afe2-214ce639fcde"},"arguments":{"codeOptions":{"variables":[{"name":"_input1","value":{"referenceType":"inputPort","portName":"inTables","portIndex":0}},{"name":"_output1","value":{"referenceType":"outputPort","portName":"outTables","portIndex":0,"arguments":{}}}],"contentType":"reference","inFile":{"parameterId":"eabb7ff0-5505-11f1-9a70-65d6167f6f21","referenceType":"parameter"},"code":"/* Start CAS sessie */\ncas casauto;\ncaslib _all_ assign;\n\n/* STAP 0 */\nproc casutil;\n    droptable casdata=\"pwc_amount_of_orders\"   incaslib=\"public\" quiet;\n    droptable casdata=\"pwc_person_addresses\" incaslib=\"public\" quiet;\n    droptable casdata=\"pwc_aggregated\"   incaslib=\"public\" quiet;\n    droptable casdata=\"pwc_concatenated\" incaslib=\"public\" quiet;\nquit;\n\n/* STAP 1 */\nproc fedsql sessref=casauto;\n    create table public.pwc_aggregated as\n    select\n        master_person_key_md5,\n        sum(total_products_in_order) as total_products_in_order,\n        sum(orderline_sales) as total_orderline_sales,\n        count(order_number_functional) as order_number_functional_count,\n        sum(waste_management) as total_waste_management,\n        sum(bathroom_toilet) as total_bathroom_toilet,\n        sum(food_enjoyment) as total_food_enjoyment,\n        sum(laundry_caring) as total_laundry_caring,\n        sum(service) as total_service,\n        sum(other) as total_others,\n        sum(_2024) as total_2024,\n        sum(_2025) as total_2025,\n        sum(outlet_jan_2024) as total_outlet_jan_2024,\n        sum(droog_molen_actie) as total_droog_molen_2024,\n        sum(refresh_steam_win) as total_steam_win,\n        sum(design_your_bin) as total_design,\n        sum(outlet_jul_2024) as total_outlet_jul_2024,\n        sum(back_to_school) as total_back_to_school,\n        sum(bin_liner_promo) as total_binliner,\n        sum(outlet_jan_2025) as total_outlet_jan_2025,\n        sum(droog_molen_promo_2025) as total_droog_molen_2025,\n        sum(outlet_jul_2025) as total_outlet_jul_2025,\n        sum(make_and_take) as total_make_take,\n        sum(newicon_win) as total_newicon,\n        sum(pink_lilac_strijkplank) as total_pink_strijkplank,\n        sum(post_holiday) as total_post_holiday,\n        sum(spring_sales) as total_spring_sales,\n        sum(back_to_school_season) as total_back_to_school_season,\n        sum(pre_holiday) as total_pre_holiday,\n        sum(off_peak) as total_off_peak,\n\n        case    when mean(net_sales) != 0 and mean(net_sales) is not null then mean(net_sales)\n                else sum(orderline_sales)  \n        end as net_sales,\n        mean(Koopkracht) as koopkracht,\n        mean(gender_encoded) as gender_encoded\n    from public.pwc_consument_data\n    group by master_person_key_md5;\nquit;\n\n\n/* STAP 2 */\ndata public.pwc_concatenated;\n    set public.pwc_consument_data\n        (keep=\n            master_person_key_md5\n            order_number_functional\n            all_products_ordered\n            all_attributes\n            all_categories\n            prd_country\n         orderby=(master_person_key_md5));\n\n    by master_person_key_md5;\n\n    length\n        order_number_functional_all $1600\n        all_products_ordered_all    $3200\n        all_attributes_all          $3200\n        all_categories_all          $3200;\n\n    retain\n        order_number_functional_all\n        all_products_ordered_all\n        all_attributes_all\n        all_categories_all;\n\n    if first.master_person_key_md5 then do;\n        order_number_functional_all = '';\n        all_products_ordered_all    = '';\n        all_attributes_all          = '';\n        all_categories_all          = '';\n    end;\n\n    order_number_functional_all =\n        catx('|', order_number_functional_all, order_number_functional);\n\n    all_products_ordered_all =\n        catx('|', all_products_ordered_all, all_products_ordered);\n\n    all_attributes_all =\n        catx('|', all_attributes_all, all_attributes);\n\n    all_categories_all =\n        catx('|', all_categories_all, all_categories);\n\n    if last.master_person_key_md5 then output;\n\n    keep\n        master_person_key_md5\n        order_number_functional_all\n        all_products_ordered_all\n        all_attributes_all\n        all_categories_all\n        prd_country;\nrun;\n\n\n\n\n/* STAP 3 */\nproc fedsql sessref=casauto;\n    create table public.pwc_amount_of_orders as\n    select\n        a.master_person_key_md5,\n\n        /* aggregaties */\n        a.total_products_in_order,\n        a.total_orderline_sales,\n        a.order_number_functional_count,\n        a.total_bathroom_toilet,\n        a.total_food_enjoyment,\n        a.total_waste_management,\n        a.total_laundry_caring,\n        a.total_service,\n        a.total_others,\n        a.total_2024,\n        a.total_2025,\n        a.net_sales,\n        a.koopkracht,\n        a.gender_encoded,\n        a.total_outlet_jan_2024,\n        a.total_droog_molen_2024,\n        a.total_steam_win,\n        a.total_design,\n        a.total_outlet_jul_2024,\n        a.total_back_to_school,\n        a.total_binliner,\n        a.total_outlet_jan_2025,\n        a.total_droog_molen_2025,\n        a.total_outlet_jul_2025,\n        a.total_make_take,\n        a.total_newicon,\n        a.total_pink_strijkplank,\n        a.total_post_holiday,\n        a.total_spring_sales,\n        a.total_back_to_school_season,\n        a.total_pre_holiday,\n        a.total_off_peak,\n\n        /* concatenaties */\n        b.order_number_functional_all,\n        b.all_products_ordered_all,\n        b.all_attributes_all,\n        b.all_categories_all,\n        b.prd_country\n    from public.pwc_aggregated a\n    left join public.pwc_concatenated b\n        on a.master_person_key_md5 = b.master_person_key_md5;\nquit;\n\n/* STAP 4 */\nproc fedsql sessref=casauto;\n    create table public.pwc_person_addresses as\n    select distinct\n        master_person_key_md5,\n        prd_gender,\n        prd_birth_date,\n        prd_zipcode,\n        prd_city,\n        prd_country,\n        /* net_sales, */\n        NUTS3,\n        Koopkracht,\n        NUTS_label,\n        gender_encoded/*,*/\n        /* age,\n        week,\n        year */\n    from public.pwc_consument_data;\nquit;\n\n/* STAP 5 */\nproc casutil;\n    promote\n        casdata=\"pwc_amount_of_orders\"\n        incaslib=\"public\"\n        outcaslib=\"public\";\n\n    promote\n        casdata=\"pwc_person_addresses\"\n        incaslib=\"public\"\n        outcaslib=\"public\";\nquit;\n\n\n/* STAP 6 */\nproc casutil;\n    droptable casdata=\"pwc_aggregated\"   incaslib=\"public\" quiet;\n    droptable casdata=\"pwc_concatenated\" incaslib=\"public\" quiet;\n    /* droptable casdata=\"pwc_joined_dataset\" incaslib=\"public\" quiet; */\nquit;\n\n/* \n\nproc fedsql sessref=casauto;\n    create table public.pwc_joined_dataset as\n    select a.*, \n        b.prd_gender,\n        b.prd_birth_date,\n        b.prd_zipcode,\n        b.prd_city,\n        b.prd_country,\n        b.net_sales,\n        b.NUTS3,\n        b.Koopkracht,\n        b.NUTS_label,\n        b.gender_encoded,\n        b.age,\n        b.week,\n        b.year -- doesnt exist\n    from public.pwc_amount_of_orders a\n    left join public.pwc_person_addresses b\n        on a.master_person_key_md5 = b.master_person_key_md5;\nquit;\n\nproc casutil;\n    promote\n        casdata=\"pwc_joined_dataset\"\n        incaslib=\"public\"\n        outcaslib=\"public\";\nquit; */\n\nproc fedsql sessref=casauto;\n    select *\n    from public.pwc_amount_of_orders\n    where total_products_in_order > 100\n    order by net_sales desc;\nquit;\n\n\n/* See each distinct value and how often it appears */\nproc fedsql sessref=casauto;\n    select net_sales, count(*) as frequency\n    from public.pwc_amount_of_orders\n    where net_sales>10000\n    group by net_sales\n    order by net_sales desc;\nquit;\n\n\nproc freq data=public.pwc_amount_of_orders;\n    tables total_outlet_jul_2025 /nocum;\n\nrun;"}},"portMappings":[{"mappingType":"tableStructure","portName":"outTables","portIndex":0,"tableStructure":{"columnDefinitions":[]}}]}},"parameters":{"e9723710-5505-11f1-9a70-65d6167f6f21":{"id":"e9723710-5505-11f1-9a70-65d6167f6f21","name":"010-import_naar_cas.sas","version":2,"parameterUsage":"INPUT","parameterType":"file","defaultValue":{"arguments":{"encoding":"UTF-8"},"sourceType":"localFile","value":"/sasdata/groups/PWC_Intern_SSBI/programs/010-import_naar_cas.sas"}},"eabb7ff0-5505-11f1-9a70-65d6167f6f21":{"id":"eabb7ff0-5505-11f1-9a70-65d6167f6f21","name":"020-order-naar-consument-aggregatie.sas","version":2,"parameterUsage":"INPUT","parameterType":"file","defaultValue":{"arguments":{"encoding":"UTF-8"},"sourceType":"localFile","value":"/sasdata/groups/PWC_Intern_SSBI/programs/020-order-naar-consument-aggregatie.sas"}}},"sourceVersion":2,"stickyNotes":[],"statusHandling":[],"version":4,"properties":{"UI_PROP_DF_OPTIMIZE":"false","UI_PROP_DF_EXECUTION_ORDERED":"true"}},"dataFlowReference":null,"executionBindings":{"sessionId":"38c2c4a5-1187-4559-8c84-bd7b7da2bcc2","environmentId":"Compute","contextId":"","arguments":{"__NO_OPTIMIZE":{"argumentType":"string","value":"true"}},"tempTablePrefix":"","sources":null,"interactive":true}},"stepId":"SWIMLANE_STEP"},"a2a111e0-9ae1-11f1-b67a-ebff2c5579d1":{"description":"","id":"a2a111e0-9ae1-11f1-b67a-ebff2c5579d1","name":"Swimlane 2","nodeType":"dataFlow","note":null,"priority":1,"properties":{"UI_PROP_IS_EXPANDED":"true","UI_PROP_LOCATION":"0 172.33333292007447"},"version":1,"dataFlowAndBindings":{"dataFlow":{"id":null,"connections":[{"sourcePort":{"node":"a2a04e90-9ae1-11f1-b67a-ebff2c5579d1","portName":"outTable","index":0},"targetPort":{"node":"a9c2be20-9ae0-11f1-b67a-ebff2c5579d1","portName":"inTable","index":0}}],"createdBy":null,"creationTimeStamp":"2026-08-18T08:49:38.868Z","description":"","eTag":null,"extendedProperties":{},"modifiedBy":null,"modifiedTimeStamp":"2026-08-18T08:49:38.868Z","name":"","nodes":{"a2a04e90-9ae1-11f1-b67a-ebff2c5579d1":{"d