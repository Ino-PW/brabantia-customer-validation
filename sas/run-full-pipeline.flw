teLength":8,"charLength":-1,"type":"Numeric","Aggregate":"","rawLength":8,"formattedLength":0},{"name":"TOTAL_DROOG_MOLEN_2025","version":2,"index":23,"byteLength":8,"charLength":-1,"type":"Numeric","Aggregate":"","rawLength":8,"formattedLength":0},{"name":"TOTAL_OUTLET_JUL_2025","version":2,"index":24,"byteLength":8,"charLength":-1,"type":"Numeric","Aggregate":"","rawLength":8,"formattedLength":0},{"name":"TOTAL_MAKE_TAKE","version":2,"index":25,"byteLength":8,"charLength":-1,"type":"Numeric","Aggregate":"","rawLength":8,"formattedLength":0},{"name":"TOTAL_NEWICON","version":2,"index":26,"byteLength":8,"charLength":-1,"type":"Numeric","Aggregate":"","rawLength":8,"formattedLength":0},{"name":"TOTAL_PINK_STRIJKPLANK","version":2,"index":27,"byteLength":8,"charLength":-1,"type":"Numeric","Aggregate":"","rawLength":8,"formattedLength":0},{"name":"TOTAL_POST_HOLIDAY","version":2,"index":28,"byteLength":8,"charLength":-1,"type":"Numeric","Aggregate":"","rawLength":8,"formattedLength":0},{"name":"TOTAL_SPRING_SALES","version":2,"index":29,"byteLength":8,"charLength":-1,"type":"Numeric","Aggregate":"","rawLength":8,"formattedLength":0},{"name":"TOTAL_BACK_TO_SCHOOL_SEASON","version":2,"index":30,"byteLength":8,"charLength":-1,"type":"Numeric","Aggregate":"","rawLength":8,"formattedLength":0},{"name":"TOTAL_PRE_HOLIDAY","version":2,"index":31,"byteLength":8,"charLength":-1,"type":"Numeric","Aggregate":"","rawLength":8,"formattedLength":0},{"name":"TOTAL_OFF_PEAK","version":2,"index":32,"byteLength":8,"charLength":-1,"type":"Numeric","Aggregate":"","rawLength":8,"formattedLength":0},{"name":"order_number_functional_all","version":2,"index":33,"byteLength":1600,"charLength":1600,"type":"Char","Aggregate":"","rawLength":1600,"formattedLength":0},{"name":"all_products_ordered_all","version":2,"index":34,"byteLength":3200,"charLength":3200,"type":"Char","Aggregate":"","rawLength":3200,"formattedLength":0},{"name":"all_attributes_all","version":2,"index":35,"byteLength":3200,"charLength":3200,"type":"Char","Aggregate":"","rawLength":3200,"formattedLength":0},{"name":"all_categories_all","version":2,"index":36,"byteLength":3200,"charLength":3200,"type":"Char","Aggregate":"","rawLength":3200,"formattedLength":0},{"name":"prd_country","version":2,"index":37,"byteLength":31,"charLength":31,"type":"Char","format":{"name":"$31.","length":31},"Aggregate":"","rawLength":31,"formattedLength":31}]},"a9c2be20-9ae0-11f1-b67a-ebff2c5579d1":{"id":"a9c2be20-9ae0-11f1-b67a-ebff2c5579d1","name":"Export","version":2,"parameterUsage":"OUTPUT","parameterType":"file","defaultValue":{"fileType":"COMMA_DELIMITED","arguments":{"dataType":"DLM","delimiter":",","encoding":"UTF-8","hasColumnHeaders":true,"hasColumnLabels":false},"sourceType":"localFile","value":"/sasdata/groups/PWC_Intern_SSBI/data/export/amount_of_orders_data.csv"}}},"sourceVersion":2,"stickyNotes":[],"statusHandling":[],"version":4,"properties":{"UI_PROP_DF_OPTIMIZE":"false","UI_PROP_DF_EXECUTION_ORDERED":"true"}},"dataFlowReference":null,"executionBindings":{"sessionId":"38c2c4a5-1187-4559-8c84-bd7b7da2bcc2","environmentId":"Compute","contextId":"","arguments":{"__NO_OPTIMIZE":{"argumentType":"string","value":"true"}},"tempTablePrefix":"","sources":null,"interactive":true}},"stepId":"SWIMLANE_STEP"}},"parameters":{},"sourceVersion":2,"stickyNotes":[],"statusHandling":[],"version":4,"properties":{"UI_PROP_DF_OPTIMIZE":"false","UI_PROP_DF_EXECUTION_ORDERED":"true"}}